CREATE TABLE IF NOT EXISTS history (
  ID INTEGER PRIMARY KEY AUTOINCREMENT,
  device_id TEXT NOT NULL,
    beep_state INTEGER CHECK (beep_state IN (0, 1)),
  pump_state INTEGER CHECK (pump_state IN (0, 1)),
  led_state INTEGER CHECK (led_state IN (0, 1)),
  fan_state INTEGER CHECK (fan_state IN (0, 1)),
  co2_concentration INTEGER,
  light_intensity INTEGER,
  soil_humidity REAL,
  soil_temperature REAL,
  air_temperature REAL,
  air_humidity REAL,
  year INTEGER,
  month INTEGER,
  date INTEGER,
  time INTEGER
)
